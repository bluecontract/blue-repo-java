                    "type": {
                      "blueId": "DLRQwz7MQeCrzjy9bohPNwtCxKEBbKaMK65KBrwjfG6K"
                    },
                    "value": "/participantsState/${steps['Prepare Participant State'].channelName}"
                  },
                  "val": {
                    "type": {
                      "blueId": "DLRQwz7MQeCrzjy9bohPNwtCxKEBbKaMK65KBrwjfG6K"
                    },
                    "value": "${steps['Prepare Participant State'].participantState}"
                  }
                }
              ]
            }
          }
        ]
      }
