        content:
          name: cdm/product/common/schedule/ObservationDate
          description: Specifies a single date on which market observations take place and specifies optional associated weighting.
          adjustedDate:
            description: |
              The date once the adjustment has been performed. (Note that this date may change if the business center holidays change).
            type:
              blueId: GX7CFUmSDrE2MzptunLCCdZwnuwwrenRQqEnHL4x3uoC
          observationReference:
            description: |
              Specifies an identification key for the market observation. This attribute can be used as a reference to assign weights to a series of dates defined in a parametricSchedule.
            type:
              blueId: GX7CFUmSDrE2MzptunLCCdZwnuwwrenRQqEnHL4x3uoC
          unadjustedDate:
            description: A date subject to adjustment.
            type:
              blueId: GX7CFUmSDrE2MzptunLCCdZwnuwwrenRQqEnHL4x3uoC
          weight:
            description: Specifies the degree of importance of the observation.
            type:
              blueId: 9eWaHYz2vKrFofdHTHAizNNu8xP6QE3WQ5y7DGrGZvyJ
        versions:
          - repositoryVersionIndex: 0
            typeBlueId: JDFk4bjDaXiaZiEkLkoPoa66bJWLrnTJB59D2KofE1yE
            attributesAdded: []
            compatibleWithCurrent: true
      - status: stable
        content:
          name: cdm/product/common/schedule/ObservationDates
          description: Describes date details for a set of observation dates in parametric or non-parametric form.
          observationSchedule:
            description: |
              Specifies a schedule of dates (non-parametric) on which market observations take place, and allows for the optional definition of weights where applicable.  When no weight is specified, then weight of each date is assumed to be 1.0
            type:
              blueId: 9u9p5Su6VwfpvLMNyxWJQBwM6RcDB48Qg2uBsbZWycbT
          parametricDates:
            description: |
              Specifies parametric terms to determine which days within a given calculation period the price would be observed. Typically associated with Commodities.
            type:
              blueId: 3G1rTAy4mfXMfESNWydvuZNryTZG6b89Cxa7M68H5Tuc
          periodicSchedule:
            description: |
              Specifies the date range and frequency on which market observations take place.  Weights can be assigned to dates in the schedule by assigning the weight and corresponding observationReference in the observationSchedule.
            type:
              blueId: CpcFaqDdJQ8XYfdxok2ySd75XES3aKvorUgbv25SG1d
        versions:
          - repositoryVersionIndex: 0
            typeBlueId: 5xxQgXAhJtfJDRtdnLVWVxyTk8pzt7rvvo41daazReS8
            attributesAdded: []
            compatibleWithCurrent: true
