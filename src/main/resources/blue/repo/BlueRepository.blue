                              value: true
                        - $returnIf:
                            cond:
                              $ne:
                                items:
                                  - $size:
                                      $var:
                                        type:
                                          blueId: GX7CFUmSDrE2MzptunLCCdZwnuwwrenRQqEnHL4x3uoC
                                        value: related
                                  - $size:
                                      $var:
                                        type:
                                          blueId: GX7CFUmSDrE2MzptunLCCdZwnuwwrenRQqEnHL4x3uoC
                                        value: contractKeys
                            expr:
