            itemType:
              blueId: 7N6isgUMMMsMJoxpjNRRfdVHiWizDFmyABkC7s3LeRZ6
            schema:
              minItems: 0
          quantity:
            description: The quantity of the security
            type:
              blueId: BADvBimj9VPGxtVkguZSpocTXA84MV8LnKjm4ocmButh
          security:
            description: The security details.
            type:
              blueId: EqW2CBgcur4w9MgDu3cEAjCKESsF2Jhsjs2gHobFQZBA
        versions:
          - repositoryVersionIndex: 0
            typeBlueId: 2PzqS7CAzS1pzkkhqUiSY7UMcE8ABiMod4Mxfurbm6Xt
