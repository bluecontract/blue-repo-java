                                                function:
                                                  type:
                                                    blueId: GX7CFUmSDrE2MzptunLCCdZwnuwwrenRQqEnHL4x3uoC
                                                  value: contractPath
                                                args:
                                                  key:
                                                    $var:
                                                      type:
                                                        blueId: GX7CFUmSDrE2MzptunLCCdZwnuwwrenRQqEnHL4x3uoC
                                                      value: contractKey
                                        - $set:
                                            name: sectionChangeCount
                                            expr:
                                              $add:
                                                items:
                                                  - $var:
                                                      type:
                                                        blueId: GX7CFUmSDrE2MzptunLCCdZwnuwwrenRQqEnHL4x3uoC
