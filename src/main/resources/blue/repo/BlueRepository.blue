            type:
              blueId: 8pFLS6aLxk9oXBuqyXeqDYzovBKubBdD4M9Cd57HDFBL
          referenceSwapCurve:
            description: |
              Defines the strike of an option when expressed by reference to a swap curve (Typically the case for a convertible bond option).
            type:
              blueId: 7ai2UcB66NBXjpmX6d6FRM6bbkqzs7qH2HihbAR72FaX
          strikePrice:
