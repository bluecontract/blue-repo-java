            type:
              blueId: 8DSFoWG9MqRSUhStqoPLrwVQiYByRh18NWbDEarN8MKF
            itemType:
              blueId: 9qWGsXauVnxS5oNKRAwfaMctCyeviwAypHKtHdS4HXZd#4
            schema:
              minItems: 0
          productQualifier:
