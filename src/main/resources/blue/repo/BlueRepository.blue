              blueId: Fsr3CBPzzThx6Pern5QLDS8TKFXzv6W3TzjS6BYSmqCc
          val:
            type:
              blueId: DtCdHJZeccxHZbwaJQZhJKaibyxKYwbj9hKw2ZsK5K4r
        versions:
