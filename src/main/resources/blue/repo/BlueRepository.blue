          steps:
            items:
              - name: Prepare
                type:
                  blueId: 4qGDz5yJxXc9dr8bsBE1B2Tg4AWuR4qHPU9H6T29m3KZ
                do:
                  items:
                    - $let:
                        order:
                          items:
                            - type:
                                blueId: GX7CFUmSDrE2MzptunLCCdZwnuwwrenRQqEnHL4x3uoC
                              value: postfix
                            - type:
                                blueId: GX7CFUmSDrE2MzptunLCCdZwnuwwrenRQqEnHL4x3uoC
                              value: proposedPath
                        vars:
                          postfix:
                            $default:
                              items:
                                - $currentContract:
                                    type:
                                      blueId: GX7CFUmSDrE2MzptunLCCdZwnuwwrenRQqEnHL4x3uoC
                                    value: /postfix
                                - type:
                                    blueId: GX7CFUmSDrE2MzptunLCCdZwnuwwrenRQqEnHL4x3uoC
                                  value: ''
                          proposedPath:
                            $concat:
                              items:
                                - type:
                                    blueId: GX7CFUmSDrE2MzptunLCCdZwnuwwrenRQqEnHL4x3uoC
                                  value: /proposedChange
                                - $var:
                                    type:
                                      blueId: GX7CFUmSDrE2MzptunLCCdZwnuwwrenRQqEnHL4x3uoC
                                    value: postfix
                    - $returnIf:
                        cond:
                          $not:
                            $exists:
                              $document:
                                path:
                                  $var:
                                    type:
                                      blueId: GX7CFUmSDrE2MzptunLCCdZwnuwwrenRQqEnHL4x3uoC
                                    value: proposedPath
                        expr:
                          changeset:
                            items: []
                          events:
                            items:
                              - type:
                                  blueId: 6jcAKEeVpGCPenpSnfwwamL2iTHBACRXPFQjEDU5pX1y
                                reason:
                                  $concat:
                                    items:
                                      - type:
                                          blueId: GX7CFUmSDrE2MzptunLCCdZwnuwwrenRQqEnHL4x3uoC
                                        value: no proposed change at
                                      - type:
                                          blueId: GX7CFUmSDrE2MzptunLCCdZwnuwwrenRQqEnHL4x3uoC
                                        value: ' '
                                      - $var:
                                          type:
                                            blueId: GX7CFUmSDrE2MzptunLCCdZwnuwwrenRQqEnHL4x3uoC
                                          value: proposedPath
                    - $appendChange:
