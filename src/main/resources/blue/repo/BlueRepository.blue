            attributesAdded: []
            compatibleWithCurrent: true
      - status: stable
        content:
          name: cdm/product/template/SchedulePeriod
          description: |
            A class that defines the period of a schedule. The period contains a set of start and end dates, quantities, fixing, and pricing data.
          calculationPeriod:
            description: Period for which the payment is generated.
            type:
              blueId: CS8mAiAkjQNBnTdUf2kTzy5n3XxifLw2FAWfWdFLvoVP
            schema:
              required: true
          deliveryPeriod:
            description: Period and time profile over which the delivery takes place.
            type:
              blueId: 9ZgNDpmFTSu9LLgMCL2cJtyFspofRjKfC2WXTu47o1R5
          fixingPeriod:
            description: Period over which the underlying price is observed.
            type:
              blueId: CS8mAiAkjQNBnTdUf2kTzy5n3XxifLw2FAWfWdFLvoVP
            schema:
              required: true
          paymentDate:
            description: Adjusted payment date.
            type:
              blueId: GX7CFUmSDrE2MzptunLCCdZwnuwwrenRQqEnHL4x3uoC
            schema:
              required: true
        versions:
          - repositoryVersionIndex: 0
            typeBlueId: GVf5UQUN1FP9wzEkH6gWBuXNjQp9mnsoejxyKU358PRt
            attributesAdded: []
            compatibleWithCurrent: true
      - status: stable
        content:
          name: cdm/product/template/SettlementPayout
          description: |
            Represents a forward settling payout. The underlier attribute captures the underlying payout, which is settled according to the settlementTerms attribute (which is part of PayoutBase). Both FX Spot and FX Forward should use this component.
          delivery:
            description: Contains the information relative to the delivery of the asset.
            type:
              blueId: Fnt7VAuUDjTmnYtzK4X7xHxWYA18N1XsK32d9sV2dugm
          deliveryTerm:
            description: |
              Also called contract month or delivery month. However, it's not always a month. It is usually expressed using a code, e.g. Z23 would be the Dec 2023 contract, (Z = December). For crude oil, the corresponding contract might be called CLZ23.
            type:
              blueId: GX7CFUmSDrE2MzptunLCCdZwnuwwrenRQqEnHL4x3uoC
          payerReceiver:
            description: Canonical representation of the payer and receiver parties applicable to each payout leg.
            type:
              blueId: 3TpG9LgXLfWvi64ZzRxGU2n5w7ZQAuAWReLvXTTaFgKQ
          priceQuantity:
            description: |
              Each payout leg must implement the quantity concept as a 'resolvable' type, which allows for different payout legs to be linked to each other (e.g. in the case of cross-curreny products).
            type:
              blueId: DmcMrxC2wq7pSMrRaCK5QHkx54U9EtEgZqojTkmfedRF
          principalPayment:
            description: |
              The specification of the principal exchange. Optional as only applicable in the case of cross-currency or zero-coupon swaps with a final payment.
            type:
              blueId: Hxc4Dbr7nrj5XkPBBiJGhPhQVnfNHWHn21HViV1FpBGM
          schedule:
            description: |
              Allows the full representation of a payout by defining a set of schedule periods. It supports standard schedule customization by expressing all the dates, quantities, and pricing data in a non-parametric way.
            type:
              blueId: ArKxUfT7icBqdZQkhyPcZmMW5oqfaGEvnvM2i8dwWnEv
          settlementTerms:
            description: |
              Each payout leg must specifies its settlement terms, including the delivery type (i.e. cash vs physical, and their respective terms), the transfer type (DvP etc.) and settlement date, if any.
            type:
              blueId: EPxCD8mPcZ6C9kuDs2tinVLVsqMQscWZPLMhYaQ4n9co
          underlier:
            description: |
              The underlying financial product that will be physically or cash settled, which can be of any type, eg an asset such as cash or a security, or the cash settlement of an index rate.
            type:
              blueId: this#3
            schema:
              required: true
        versions:
          - repositoryVersionIndex: 0
            typeBlueId: 9qWGsXauVnxS5oNKRAwfaMctCyeviwAypHKtHdS4HXZd#2
            attributesAdded: []
            compatibleWithCurrent: true
