                                      value: /contracts/granterChannel/accountId
                                  granteeDocumentId:
                                    $document:
                                      type:
                                        blueId: GX7CFUmSDrE2MzptunLCCdZwnuwwrenRQqEnHL4x3uoC
                                      value: /granteeDocumentId
                                  permissionsList:
                                    $choose:
                                      cond:
                                        $exists:
                                          $document:
                                            type:
                                              blueId: GX7CFUmSDrE2MzptunLCCdZwnuwwrenRQqEnHL4x3uoC
                                            value: /allowedWorkerAgencyPermissions
                                      then:
                                        $document:
                                          type:
                                            blueId: GX7CFUmSDrE2MzptunLCCdZwnuwwrenRQqEnHL4x3uoC
                                          value: /allowedWorkerAgencyPermissions
                                      else:
                                        items: []
                            - $if:
                                cond:
                                  $not:
                                    $call:
                                      function:
                                        type:
                                          blueId: GX7CFUmSDrE2MzptunLCCdZwnuwwrenRQqEnHL4x3uoC
                                        value: isNonEmptyText
                                      args:
                                        val:
                                          $var:
                                            type:
                                              blueId: GX7CFUmSDrE2MzptunLCCdZwnuwwrenRQqEnHL4x3uoC
                                            value: granterId
                                then:
                                  items:
                                    - $set:
                                        name: issues
                                        expr:
                                          $listConcat:
                                            items:
                                              - $var:
                                                  type:
                                                    blueId: GX7CFUmSDrE2MzptunLCCdZwnuwwrenRQqEnHL4x3uoC
                                                  value: issues
                                              - items:
                                                  - type:
                                                      blueId: GX7CFUmSDrE2MzptunLCCdZwnuwwrenRQqEnHL4x3uoC
                                                    value: granterChannel must be bound to an accountId
                            - $if:
                                cond:
                                  $not:
                                    $call:
                                      function:
                                        type:
                                          blueId: GX7CFUmSDrE2MzptunLCCdZwnuwwrenRQqEnHL4x3uoC
                                        value: isNonEmptyText
                                      args:
