                                                  value: issues
                                              - items:
                                                  - type:
                                                      blueId: GX7CFUmSDrE2MzptunLCCdZwnuwwrenRQqEnHL4x3uoC
                                                    value: permissions block is missing
                                else:
                                  items:
                                    - $if:
                                        cond:
                                          $ne:
                                            items:
                                              - $var:
                                                  name: perms
                                                  path:
                                                    type:
                                                      blueId: GX7CFUmSDrE2MzptunLCCdZwnuwwrenRQqEnHL4x3uoC
                                                    value: /read
                                              - type:
                                                  blueId: AwvXD961fmnmqcSQhjMA7r15HpVh39cefb6ZTyUz2Fm2
                                                value: true
                                        then:
                                          items:
                                            - $set:
                                                name: issues
                                                expr:
                                                  $listConcat:
                                                    items:
                                                      - $var:
                                                          type:
                                                            blueId: GX7CFUmSDrE2MzptunLCCdZwnuwwrenRQqEnHL4x3uoC
                                                          value: issues
                                                      - items:
                                                          - type:
                                                              blueId: GX7CFUmSDrE2MzptunLCCdZwnuwwrenRQqEnHL4x3uoC
                                                            value: permissions.read must be true for SDPG
                                    - $if:
                                        cond:
                                          $call:
                                            function:
                                              type:
                                                blueId: GX7CFUmSDrE2MzptunLCCdZwnuwwrenRQqEnHL4x3uoC
                                              value: hasBadSingleOps
                                            args:
                                              ops:
                                                $var:
                                                  type:
                                                    blueId: GX7CFUmSDrE2MzptunLCCdZwnuwwrenRQqEnHL4x3uoC
                                                  value: singleOps
                                        then:
                                          items:
                                            - $set:
                                                name: issues
                                                expr:
                                                  $listConcat:
                                                    items:
                                                      - $var:
                                                          type:
                                                            blueId: GX7CFUmSDrE2MzptunLCCdZwnuwwrenRQqEnHL4x3uoC
                                                          value: issues
                                                      - items:
                                                          - type:
                                                              blueId: GX7CFUmSDrE2MzptunLCCdZwnuwwrenRQqEnHL4x3uoC
                                                            value: permissions.singleOps must contain only non-empty strings
                                    - $if:
                                        cond:
                                          $and:
                                            items:
                                              - $eq:
                                                  items:
                                                    - $var:
                                                        name: perms
                                                        path:
                                                          type:
                                                            blueId: GX7CFUmSDrE2MzptunLCCdZwnuwwrenRQqEnHL4x3uoC
                                                          value: /allOps
                                                    - type:
                                                        blueId: AwvXD961fmnmqcSQhjMA7r15HpVh39cefb6ZTyUz2Fm2
                                                      value: true
                                              - $var:
                                                  type:
                                                    blueId: GX7CFUmSDrE2MzptunLCCdZwnuwwrenRQqEnHL4x3uoC
                                                  value: hasSingle
                                        then:
                                          items:
                                            - $set:
                                                name: issues
                                                expr:
                                                  $listConcat:
                                                    items:
                                                      - $var:
                                                          type:
                                                            blueId: GX7CFUmSDrE2MzptunLCCdZwnuwwrenRQqEnHL4x3uoC
                                                          value: issues
                                                      - items:
                                                          - type:
                                                              blueId: GX7CFUmSDrE2MzptunLCCdZwnuwwrenRQqEnHL4x3uoC
                                                            value: permissions.allOps=true and permissions.singleOps are mutually exclusive
                            - $if:
                                cond:
                                  $gt:
                                    items:
                                      - $size:
                                          $var:
                                            type:
                                              blueId: GX7CFUmSDrE2MzptunLCCdZwnuwwrenRQqEnHL4x3uoC
                                            value: issues
                                      - type:
                                          blueId: E2LM6qgzWG9ttagq2xTmiZkgYEAgkYedFCmU9v7NnVEq
                                        value: 0
                                then:
                                  items:
                                    - $appendEvent:
                                        type:
                                          blueId: 7BEbHgR3h4y9HDLvxnKSMyGZZqYnA8Jm2cFuTMjDuCJg
                                        issues:
                                          $var:
                                            type:
                                              blueId: GX7CFUmSDrE2MzptunLCCdZwnuwwrenRQqEnHL4x3uoC
                                            value: issues
                                else:
                                  items:
                                    - $appendEvent:
                                        type:
                                          blueId: 6rJFGtfmUHZyspx5UNtUvSjNn89XqmBHzmMRiQHjhPX3
                            - $return:
                                events:
                                  $events:
                                    type:
                                      blueId: AwvXD961fmnmqcSQhjMA7r15HpVh39cefb6ZTyUz2Fm2
                                    value: true
