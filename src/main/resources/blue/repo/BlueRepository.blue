                                    type:
                                      blueId: GX7CFUmSDrE2MzptunLCCdZwnuwwrenRQqEnHL4x3uoC
                                    value: isNonEmptyText
                                  args:
                                    val:
                                      $var:
                                        type:
                                          blueId: GX7CFUmSDrE2MzptunLCCdZwnuwwrenRQqEnHL4x3uoC
                                        value: opName
                      validate:
                        do:
                          items:
                            - $let:
                                vars:
                                  issues:
                                    items: []
                                  seenWorkerTypes:
                                    $emptyObject:
