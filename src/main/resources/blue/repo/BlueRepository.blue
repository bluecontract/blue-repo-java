      - status: stable
        content:
          name: cdm/product/template/Product
          description: Enables either a TransferableProduct or a NonTransferableProduct to be used in an underlier.
          NonTransferableProduct:
            description: |
              The non-transferable product data type represents a product that can be traded (as part of a TradableProduct) but cannot be transferred to others.
            type:
              blueId: this#4
          TransferableProduct:
            description: |
              A TransferableProduct is a type of financial product which can be held or transferred, represented as an Asset with the addition of specific EconomicTerms.
            type:
              blueId: this#8
        versions:
          - repositoryVersionIndex: 0
            typeBlueId: 9qWGsXauVnxS5oNKRAwfaMctCyeviwAypHKtHdS4HXZd#0
            attributesAdded: []
            compatibleWithCurrent: true
      - status: stable
        content:
          name: cdm/product/template/Quanto
          description: |
            Determines the currency rate that the seller of the equity amounts will apply at each valuation date for converting the respective amounts into a currency that is different from the currency denomination of the underlier.
          fixingTime:
            description: |
              The time at which the spot currency exchange rate will be observed. It is specified as a time in a business day calendar location, e.g. 11:00am London time.
            type:
              blueId: DJHcCUvgkjrpH1UjAWPG6z2avBDGcvFeWgf2oWZMM7ef
          fxRate:
            description: Specifies a currency conversion rate.
            type:
              blueId: 8DSFoWG9MqRSUhStqoPLrwVQiYByRh18NWbDEarN8MKF
            itemType:
              blueId: 9ckjvQUVET3Ngrrx4MafJVHq6idJAxX6WnY4HNKKkuj
            schema:
              minItems: 0
          fxSpotRateSource:
            description: |
              Specifies the methodology (reference source and, optionally, fixing time) to be used for determining a currency conversion rate.
            type:
              blueId: Er5xdgizmYHVQiqxbHxo9DYjuP1uTdYqWsrVPJRV2S5P
        versions:
          - repositoryVersionIndex: 0
            typeBlueId: DaYnTURjZm4kvFWmTR5RzjRmtWTcWRaTXf96jLwxH8kn
            attributesAdded: []
            compatibleWithCurrent: true
      - status: stable
        content:
          name: cdm/product/template/RepoDurationEnum
          description: |
            A duration code for a Repo (or Securities Lending) transaction. There are many business and market rules that are derived from the duration of the transaction.
          type:
            blueId: GX7CFUmSDrE2MzptunLCCdZwnuwwrenRQqEnHL4x3uoC
          schema:
            enum:
              - Overnight
              - Term
