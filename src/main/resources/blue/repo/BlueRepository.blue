                                                                  blueId: GX7CFUmSDrE2MzptunLCCdZwnuwwrenRQqEnHL4x3uoC
                                                                value: sectionKey
                                                            - type:
                                                                blueId: GX7CFUmSDrE2MzptunLCCdZwnuwwrenRQqEnHL4x3uoC
                                                              value: relatedContracts
                                                then:
                                                  $document:
                                                    path:
                                                      $pointerJoin:
                                                        items:
                                                          - type:
                                                              blueId: GX7CFUmSDrE2MzptunLCCdZwnuwwrenRQqEnHL4x3uoC
                                                            value: contracts
                                                          - $var:
                                                              type:
                                                                blueId: GX7CFUmSDrE2MzptunLCCdZwnuwwrenRQqEnHL4x3uoC
                                                              value: sectionKey
                                                          - type:
                                                              blueId: GX7CFUmSDrE2MzptunLCCdZwnuwwrenRQqEnHL4x3uoC
                                                            value: relatedContracts
                                                else:
                                                  items: []
                                - $returnIf:
                                    cond:
                                      $not:
                                        $truthy:
                                          $var:
                                            type:
                                              blueId: GX7CFUmSDrE2MzptunLCCdZwnuwwrenRQqEnHL4x3uoC
                                            value: sectionKey
                                    expr:
                                      $call:
                                        function:
                                          type:
                                            blueId: GX7CFUmSDrE2MzptunLCCdZwnuwwrenRQqEnHL4x3uoC
                                          value: invalid
                                        args:
                                          reason:
                                            type:
                                              blueId: GX7CFUmSDrE2MzptunLCCdZwnuwwrenRQqEnHL4x3uoC
                                            value: sectionChanges.remove is missing sectionKey
                                - $forEach:
                                    in:
                                      $var:
                                        type:
                                          blueId: GX7CFUmSDrE2MzptunLCCdZwnuwwrenRQqEnHL4x3uoC
                                        value: related
                                    item:
                                      type:
                                        blueId: GX7CFUmSDrE2MzptunLCCdZwnuwwrenRQqEnHL4x3uoC
                                      value: contractKey
                                    do:
