                                                              value: /singleOps
                                                      then:
                                                        $var:
                                                          name: perms
                                                          path:
                                                            type:
                                                              blueId: GX7CFUmSDrE2MzptunLCCdZwnuwwrenRQqEnHL4x3uoC
                                                            value: /singleOps
                                                      else:
                                                        items: []
                                                  hasSingle:
                                                    $gt:
                                                      items:
                                                        - $size:
                                                            $call:
                                                              function:
                                                                type:
                                                                  blueId: GX7CFUmSDrE2MzptunLCCdZwnuwwrenRQqEnHL4x3uoC
                                                                value: asList
                                                              args:
                                                                val:
                                                                  $var:
                                                                    type:
                                                                      blueId: GX7CFUmSDrE2MzptunLCCdZwnuwwrenRQqEnHL4x3uoC
                                                                    value: singleOps
                                                        - type:
                                                            blueId: E2LM6qgzWG9ttagq2xTmiZkgYEAgkYedFCmU9v7NnVEq
                                                          value: 0
                                            - $if:
                                                cond:
                                                  $ne:
                                                    items:
                                                      - $var:
                                                          name: perms
                                                          path:
                                                            type:
                                                              blueId: GX7CFUmSDrE2MzptunLCCdZwnuwwrenRQqEnHL4x3uoC
                                                            value: /read
                                                      - type:
                                                          blueId: AwvXD961fmnmqcSQhjMA7r15HpVh39cefb6ZTyUz2Fm2
                                                        value: true
                                                then:
                                                  items:
                                                    - $set:
                                                        name: issues
                                                        expr:
                                                          $listConcat:
                                                            items:
                                                              - $var:
                                                                  type:
                                                                    blueId: GX7CFUmSDrE2MzptunLCCdZwnuwwrenRQqEnHL4x3uoC
                                                                  value: issues
                                                              - items:
                                                                  - $concat:
                                                                      items:
                                                                        - type:
                                                                            blueId: GX7CFUmSDrE2MzptunLCCdZwnuwwrenRQqEnHL4x3uoC
                                                                          value: links['
                                                                        - $var:
                                                                            type:
                                                                              blueId: GX7CFUmSDrE2MzptunLCCdZwnuwwrenRQqEnHL4x3uoC
                                                                            value: anchor
                                                                        - type:
                                                                            blueId: GX7CFUmSDrE2MzptunLCCdZwnuwwrenRQqEnHL4x3uoC
                                                                          value: '''].read must be true'
                                            - $if:
                                                cond:
                                                  $call:
                                                    function:
                                                      type:
                                                        blueId: GX7CFUmSDrE2MzptunLCCdZwnuwwrenRQqEnHL4x3uoC
                                                      value: hasBadSingleOps
                                                    args:
                                                      ops:
                                                        $var:
                                                          type:
                                                            blueId: GX7CFUmSDrE2MzptunLCCdZwnuwwrenRQqEnHL4x3uoC
                                                          value: singleOps
                                                then:
                                                  items:
                                                    - $set:
                                                        name: issues
                                                        expr:
                                                          $listConcat:
