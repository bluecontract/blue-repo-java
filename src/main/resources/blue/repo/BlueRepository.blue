                                        blueId: GX7CFUmSDrE2MzptunLCCdZwnuwwrenRQqEnHL4x3uoC
                                      value: nextDeliveryError
                                vars:
                                  acceptedAt:
                                    $call:
                                      function:
                                        type:
                                          blueId: GX7CFUmSDrE2MzptunLCCdZwnuwwrenRQqEnHL4x3uoC
                                        value: asText
                                      args:
                                        val:
                                          $event:
                                            type:
                                              blueId: GX7CFUmSDrE2MzptunLCCdZwnuwwrenRQqEnHL4x3uoC
                                            value: /message/request/acceptedAt
                                  currentDecisionStatus:
                                    $call:
                                      function:
                                        type:
                                          blueId: GX7CFUmSDrE2MzptunLCCdZwnuwwrenRQqEnHL4x3uoC
                                        value: asText
                                      args:
                                        val:
                                          $document:
                                            type:
                                              blueId: GX7CFUmSDrE2MzptunLCCdZwnuwwrenRQqEnHL4x3uoC
                                            value: /clientDecisionStatus
                                  alreadyDecided:
                                    $or:
                                      items:
                                        - $eq:
                                            items:
