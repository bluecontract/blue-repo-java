                                                              value: true
                                                      - $var:
                                                          type:
                                                            blueId: GX7CFUmSDrE2MzptunLCCdZwnuwwrenRQqEnHL4x3uoC
                                                          value: hasSingle
                                                then:
                                                  items:
                                                    - $set:
                                                        name: issues
                                                        expr:
                                                          $listConcat:
                                                            items:
                                                              - $var:
                                                                  type:
                                                                    blueId: GX7CFUmSDrE2MzptunLCCdZwnuwwrenRQqEnHL4x3uoC
                                                                  value: issues
                                                              - items:
                                                                  - $concat:
                                                                      items:
                                                                        - $var:
                                                                            type:
                                                                              blueId: GX7CFUmSDrE2MzptunLCCdZwnuwwrenRQqEnHL4x3uoC
                                                                            value: itemPath
                                                                        - type:
                                                                            blueId: GX7CFUmSDrE2MzptunLCCdZwnuwwrenRQqEnHL4x3uoC
                                                                          value: .permissions.allOps=true and
                                                                        - type:
                                                                            blueId: GX7CFUmSDrE2MzptunLCCdZwnuwwrenRQqEnHL4x3uoC
                                                                          value: ' '
                                                                        - $var:
                                                                            type:
                                                                              blueId: GX7CFUmSDrE2MzptunLCCdZwnuwwrenRQqEnHL4x3uoC
                                                                            value: itemPath
                                                                        - type:
                                                                            blueId: GX7CFUmSDrE2MzptunLCCdZwnuwwrenRQqEnHL4x3uoC
                                                                          value: .permissions.singleOps are mutually exclusive
                            - $if:
                                cond:
                                  $gt:
                                    items:
                                      - $size:
                                          $var:
                                            type:
                                              blueId: GX7CFUmSDrE2MzptunLCCdZwnuwwrenRQqEnHL4x3uoC
                                            value: issues
                                      - type:
                                          blueId: E2LM6qgzWG9ttagq2xTmiZkgYEAgkYedFCmU9v7NnVEq
                                        value: 0
                                then:
                                  items:
                                    - $appendEvent:
                                        type:
                                          blueId: B1RnGH4azPberZAn1F3YrP5c2sGV939EpruSPBD2Kc1u
                                        issues:
                                          $var:
                                            type:
                                              blueId: GX7CFUmSDrE2MzptunLCCdZwnuwwrenRQqEnHL4x3uoC
                                            value: issues
                                else:
                                  items:
                                    - $appendEvent:
                                        type:
                                          blueId: J7ssmNEa6YpxrLFTqZfwgD4uiz3cSyNLNaC4WbnLEhj7
                            - $return:
                                events:
                                  $events:
                                    type:
                                      blueId: AwvXD961fmnmqcSQhjMA7r15HpVh39cefb6ZTyUz2Fm2
                                    value: true
