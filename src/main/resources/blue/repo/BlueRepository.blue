                                - $text:
                                    $default:
                                      items:
                                        - $var:
                                            name: entry
                                            path:
                                              type:
                                                blueId: GX7CFUmSDrE2MzptunLCCdZwnuwwrenRQqEnHL4x3uoC
                                              value: /path
                                        - type:
                                            blueId: GX7CFUmSDrE2MzptunLCCdZwnuwwrenRQqEnHL4x3uoC
                                          value: ''
                                - type:
                                    blueId: GX7CFUmSDrE2MzptunLCCdZwnuwwrenRQqEnHL4x3uoC
                                  value: /contracts/
                  isProposedChangePatchEntry:
                    args:
                      entry:
                        description: BEX helper argument.
                    expr:
                      $startsWith:
                        items:
                          - $text:
                              $default:
                                items:
                                  - $var:
                                      name: entry
                                      path:
                                        type:
                                          blueId: GX7CFUmSDrE2MzptunLCCdZwnuwwrenRQqEnHL4x3uoC
                                        value: /path
                                  - type:
                                      blueId: GX7CFUmSDrE2MzptunLCCdZwnuwwrenRQqEnHL4x3uoC
                                    value: ''
                          - type:
                              blueId: GX7CFUmSDrE2MzptunLCCdZwnuwwrenRQqEnHL4x3uoC
                            value: /proposedChange
                  hasMatchingRelatedContracts:
                    args:
                      section:
                        description: BEX helper argument.
                      contractKeys:
                        description: BEX helper argument.
                    do:
                      items:
                        - $let:
                            order:
                              items:
                                - type:
                                    blueId: GX7CFUmSDrE2MzptunLCCdZwnuwwrenRQqEnHL4x3uoC
                                  value: related
