                                                              - $var:
                                                                  type:
                                                                    blueId: GX7CFUmSDrE2MzptunLCCdZwnuwwrenRQqEnHL4x3uoC
                                                                  value: issues
                                                              - items:
                                                                  - $concat:
                                                                      items:
                                                                        - type:
                                                                            blueId: GX7CFUmSDrE2MzptunLCCdZwnuwwrenRQqEnHL4x3uoC
                                                                          value: links['
                                                                        - $var:
                                                                            type:
                                                                              blueId: GX7CFUmSDrE2MzptunLCCdZwnuwwrenRQqEnHL4x3uoC
                                                                            value: anchor
