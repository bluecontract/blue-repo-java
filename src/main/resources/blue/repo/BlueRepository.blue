                                        blueId: GX7CFUmSDrE2MzptunLCCdZwnuwwrenRQqEnHL4x3uoC
                                      value: /permissions
                                  singleOps:
                                    $choose:
                                      cond:
                                        $exists:
                                          $document:
                                            type:
                                              blueId: GX7CFUmSDrE2MzptunLCCdZwnuwwrenRQqEnHL4x3uoC
                                            value: /permissions/singleOps
                                      then:
