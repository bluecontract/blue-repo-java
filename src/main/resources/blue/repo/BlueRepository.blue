                                                            - type:
                                                                blueId: GX7CFUmSDrE2MzptunLCCdZwnuwwrenRQqEnHL4x3uoC
                                                              value: contracts
                                                            - $var:
                                                                type:
                                                                  blueId: GX7CFUmSDrE2MzptunLCCdZwnuwwrenRQqEnHL4x3uoC
                                                                value: sectionKey
                                                            - type:
                                                                blueId: GX7CFUmSDrE2MzptunLCCdZwnuwwrenRQqEnHL4x3uoC
                                                              value: relatedContracts
                                                then:
                                                  $document:
                                                    path:
                                                      $pointerJoin:
                                                        items:
                                                          - type:
                                                              blueId: GX7CFUmSDrE2MzptunLCCdZwnuwwrenRQqEnHL4x3uoC
                                                            value: contracts
                                                          - $var:
                                                              type:
                                                                blueId: GX7CFUmSDrE2MzptunLCCdZwnuwwrenRQqEnHL4x3uoC
                                                              value: sectionKey
                                                          - type:
                                                              blueId: GX7CFUmSDrE2MzptunLCCdZwnuwwrenRQqEnHL4x3uoC
                                                            value: relatedContracts
                                                else:
                                                  items: []
                                - $returnIf:
                                    cond:
                                      $not:
                                        $truthy:
                                          $var:
                                            type:
                                              blueId: GX7CFUmSDrE2MzptunLCCdZwnuwwrenRQqEnHL4x3uoC
                                            value: sectionKey
                                    expr:
                                      $call:
                                        function:
                                          type:
                                            blueId: GX7CFUmSDrE2MzptunLCCdZwnuwwrenRQqEnHL4x3uoC
                                          value: invalid
                                        args:
                                          reason:
                                            type:
                                              blueId: GX7CFUmSDrE2MzptunLCCdZwnuwwrenRQqEnHL4x3uoC
                                            value: sectionChanges.remove is missing sectionKey
                                - $forEach:
                                    in:
                                      $var:
                                        type:
                                          blueId: GX7CFUmSDrE2MzptunLCCdZwnuwwrenRQqEnHL4x3uoC
                                        value: related
                                    item:
                                      type:
                                        blueId: GX7CFUmSDrE2MzptunLCCdZwnuwwrenRQqEnHL4x3uoC
                                      value: contractKey
                                    do:
                                      items:
                                        - $appendChange:
                                            op:
                                              type:
                                                blueId: GX7CFUmSDrE2MzptunLCCdZwnuwwrenRQqEnHL4x3uoC
                                              value: remove
                                            path:
                                              $call:
                                                function:
                                                  type:
                                                    blueId: GX7CFUmSDrE2MzptunLCCdZwnuwwrenRQqEnHL4x3uoC
                                                  value: contractPath
                                                args:
                                                  key:
                                                    $var:
                                                      type:
                                                        blueId: GX7CFUmSDrE2MzptunLCCdZwnuwwrenRQqEnHL4x3uoC
                                                      value: contractKey
                                        - $set:
                                            name: sectionChangeCount
                                            expr:
                                              $add:
                                                items:
                                                  - $var:
                                                      type:
                                                        blueId: GX7CFUmSDrE2MzptunLCCdZwnuwwrenRQqEnHL4x3uoC
                                                      value: sectionChangeCount
                                                  - type:
                                                      blueId: E2LM6qgzWG9ttagq2xTmiZkgYEAgkYedFCmU9v7NnVEq
                                                    value: 1
                                - $appendChange:
                                    op:
                                      type:
                                        blueId: GX7CFUmSDrE2MzptunLCCdZwnuwwrenRQqEnHL4x3uoC
                                      value: remove
                                    path:
                                      $call:
                                        function:
                                          type:
                                            blueId: GX7CFUmSDrE2MzptunLCCdZwnuwwrenRQqEnHL4x3uoC
                                          value: contractPath
                                        args:
                                          key:
                                            $var:
                                              type:
                                                blueId: GX7CFUmSDrE2MzptunLCCdZwnuwwrenRQqEnHL4x3uoC
                                              value: sectionKey
                                - $set:
                                    name: sectionChangeCount
                                    expr:
                                      $add:
                                        items:
                                          - $var:
                                              type:
                                                blueId: GX7CFUmSDrE2MzptunLCCdZwnuwwrenRQqEnHL4x3uoC
                                              value: sectionChangeCount
                                          - type:
                                              blueId: E2LM6qgzWG9ttagq2xTmiZkgYEAgkYedFCmU9v7NnVEq
                                            value: 1
                        - $returnIf:
                            cond:
                              $eq:
                                items:
                                  - $add:
                                      items:
                                        - $var:
                                            type:
                                              blueId: GX7CFUmSDrE2MzptunLCCdZwnuwwrenRQqEnHL4x3uoC
                                            value: sectionChangeCount
                                        - $size:
                                            $var:
                                              type:
                                                blueId: GX7CFUmSDrE2MzptunLCCdZwnuwwrenRQqEnHL4x3uoC
                                              value: requestChangeset
                                  - type:
                                      blueId: E2LM6qgzWG9ttagq2xTmiZkgYEAgkYedFCmU9v7NnVEq
                                    value: 0
                            expr:
                              $call:
                                function:
                                  type:
                                    blueId: GX7CFUmSDrE2MzptunLCCdZwnuwwrenRQqEnHL4x3uoC
                                  value: invalid
                                args:
                                  reason:
                                    type:
                                      blueId: GX7CFUmSDrE2MzptunLCCdZwnuwwrenRQqEnHL4x3uoC
                                    value: no changes provided
                        - $appendChanges:
                            $var:
                              type:
                                blueId: GX7CFUmSDrE2MzptunLCCdZwnuwwrenRQqEnHL4x3uoC
                              value: requestChangeset
                        - $appendChange:
                            op:
                              type:
                                blueId: GX7CFUmSDrE2MzptunLCCdZwnuwwrenRQqEnHL4x3uoC
                              value: remove
                            path:
                              $var:
                                type:
                                  blueId: GX7CFUmSDrE2MzptunLCCdZwnuwwrenRQqEnHL4x3uoC
                                value: proposedPath
                        - $return:
                            changeset:
                              $changeset:
                                type:
                                  blueId: AwvXD961fmnmqcSQhjMA7r15HpVh39cefb6ZTyUz2Fm2
                                value: true
                            events:
                              $events:
                                type:
                                  blueId: AwvXD961fmnmqcSQhjMA7r15HpVh39cefb6ZTyUz2Fm2
                                value: true
        versions:
          - repositoryVersionIndex: 0
            typeBlueId: 72S8pnuUiaTtNAJczeSRRMqXqmtzsKWpuvpSBEHywSmB
            attributesAdded: []
            compatibleWithCurrent: true
      - status: dev
        content:
          name: Change Operation
          description: |
            Operation marker for applying a Change Request immediately rather than first storing it as a proposal. It is intended
            for contexts where the caller is already authorized to request the change and the document policy allows direct
            application.

            The operation's `request` shape is Workflows/Change Request. The corresponding Change Workflow validates the request,
            blocks forbidden `/contracts` modifications when Contracts Change Policy requires sectionChanges, rejects attempts to
            mutate proposal state recursively, and then applies the changes through Update Document.

            Use this operation when immediate mutation is acceptable. Use Propose Change Operation followed by Accept or Reject when
            changes must be reviewed before becoming document state.
          type:
            blueId: C6pXAJMfAwdobNijF6SqWvK32PSQ9Z1wy8vh3fx2yWtG
          request:
            type:
              blueId: 6DTYzUFXoVEV5WjVKmQveSztfXfVN5nr1bso3ygW9ocU
        versions:
          - repositoryVersionIndex: 0
            typeBlueId: HSSVZzrDxPE8wRvcnjKjXFC7wuyR7BEYgYgDAg5Fd3J8
            attributesAdded: []
            compatibleWithCurrent: true
      - status: dev
        content:
          name: Change Request
          description: |
            Payload type for direct and proposed document-change operations. A Change Request describes what the caller wants to
            change, why it is being changed, and—when contract mutation is governed by section policy—how the change maps to
            logical document sections.

            `summary` is the human-readable explanation required when a proposal is stored for later acceptance. `changeset` is the
            list of patch entries for ordinary selected-document fields. `sectionChanges` is the structured form for modifying the
            document's `contracts` map through Document Section markers when Contracts Change Policy is enabled. This split exists
            so participants can review contract changes by section instead of accepting arbitrary low-level `/contracts` patches.

            A Change Request is data. It does not mutate by itself. Change Workflow, Propose Change Workflow, Accept Change
            Workflow, and Reject Change Workflow interpret it and produce processor patches or invalid-proposal events.
          summary:
            description: Human-readable summary of the requested change. Required when proposal is created.
            type:
              blueId: GX7CFUmSDrE2MzptunLCCdZwnuwwrenRQqEnHL4x3uoC
          changeset:
            description: RFC 6902 patch entries outside /contracts (blocked by policy if it touches /contracts).
            type:
              blueId: 8DSFoWG9MqRSUhStqoPLrwVQiYByRh18NWbDEarN8MKF
            itemType:
              blueId: 61W96XosAp3DrEC7PuqLYtmF2A6ETpqH6qF2DgYwDq4c
          sectionChanges:
            description: Section-based /contracts mutations (required when Contracts Change Policy is enabled).
            type:
              blueId: 8FdfJApa4H55iYGnn2BVZcAq7tKYB6GrtkcftMgo6fjc
        versions:
          - repositoryVersionIndex: 0
            typeBlueId: 6DTYzUFXoVEV5WjVKmQveSztfXfVN5nr1bso3ygW9ocU
            attributesAdded: []
            compatibleWithCurrent: true
      - status: dev
        content:
          name: Change Workflow
          description: Applies a requested changeset immediately to the document.
          type:
            blueId: J1U1pzPn6QEhrWbLEM5wYwgAqaVRcJu4QKXozc1rWR3J
          request:
            description: Expected request payload for this workflow.
            type:
              blueId: 6DTYzUFXoVEV5WjVKmQveSztfXfVN5nr1bso3ygW9ocU
          steps:
            items:
              - name: Prepare
                type:
                  blueId: 4qGDz5yJxXc9dr8bsBE1B2Tg4AWuR4qHPU9H6T29m3KZ
                entry:
                  type:
                    blueId: GX7CFUmSDrE2MzptunLCCdZwnuwwrenRQqEnHL4x3uoC
                  value: prepare
                functions:
                  invalid:
                    args:
                      reason:
                        description: BEX helper argument.
                    expr:
                      changeset:
                        items: []
                      events:
                        items:
                          - type:
                              blueId: 6jcAKEeVpGCPenpSnfwwamL2iTHBACRXPFQjEDU5pX1y
                            reason:
                              $var:
                                type:
                                  blueId: GX7CFUmSDrE2MzptunLCCdZwnuwwrenRQqEnHL4x3uoC
                                value: reason
                  asList:
                    args:
                      val:
                        description: BEX helper argument.
                    expr:
                      $choose:
                        cond:
                          $isKind:
                            val:
                              $var:
                                type:
                                  blueId: GX7CFUmSDrE2MzptunLCCdZwnuwwrenRQqEnHL4x3uoC
                                value: val
                            kind:
                              type:
                                blueId: GX7CFUmSDrE2MzptunLCCdZwnuwwrenRQqEnHL4x3uoC
                              value: list
                        then:
                          $var:
                            type:
                              blueId: GX7CFUmSDrE2MzptunLCCdZwnuwwrenRQqEnHL4x3uoC
                            value: val
                        else:
                          items: []
                  asObject:
                    args:
                      val:
                        description: BEX helper argument.
                    expr:
                      $choose:
                        cond:
                          $isKind:
                            val:
                              $var:
                                type:
                                  blueId: GX7CFUmSDrE2MzptunLCCdZwnuwwrenRQqEnHL4x3uoC
                                value: val
                            kind:
                              type:
                                blueId: GX7CFUmSDrE2MzptunLCCdZwnuwwrenRQqEnHL4x3uoC
                              value: object
                        then:
                          $var:
                            type:
                              blueId: GX7CFUmSDrE2MzptunLCCdZwnuwwrenRQqEnHL4x3uoC
                            value: val
                        else:
                          $emptyObject:
                            type:
                              blueId: AwvXD961fmnmqcSQhjMA7r15HpVh39cefb6ZTyUz2Fm2
                            value: true
                  isMetaKey:
                    args:
                      key:
                        description: BEX helper argument.
                    expr:
                      $or:
                        items:
                          - $eq:
                              items:
                                - $var:
                                    type:
                                      blueId: GX7CFUmSDrE2MzptunLCCdZwnuwwrenRQqEnHL4x3uoC
                                    value: key
                                - type:
                                    blueId: GX7CFUmSDrE2MzptunLCCdZwnuwwrenRQqEnHL4x3uoC
                                  value: type
                          - $eq:
                              items:
                                - $var:
                                    type:
                                      blueId: GX7CFUmSDrE2MzptunLCCdZwnuwwrenRQqEnHL4x3uoC
                                    value: key
                                - type:
                                    blueId: GX7CFUmSDrE2MzptunLCCdZwnuwwrenRQqEnHL4x3uoC
                                  value: keyType
                          - $eq:
                              items:
                                - $var:
                                    type:
                                      blueId: GX7CFUmSDrE2MzptunLCCdZwnuwwrenRQqEnHL4x3uoC
                                    value: key
                                - type:
                                    blueId: GX7CFUmSDrE2MzptunLCCdZwnuwwrenRQqEnHL4x3uoC
                                  value: valueType
                          - $eq:
                              items:
                                - $var:
                                    type:
                                      blueId: GX7CFUmSDrE2MzptunLCCdZwnuwwrenRQqEnHL4x3uoC
                                    value: key
                                - type:
                                    blueId: GX7CFUmSDrE2MzptunLCCdZwnuwwrenRQqEnHL4x3uoC
                                  value: description
                  contractKeys:
                    args:
                      contractsMap:
                        description: BEX helper argument.
                    expr:
                      $filter:
                        in:
                          $keys:
                            $call:
                              function:
                                type:
                                  blueId: GX7CFUmSDrE2MzptunLCCdZwnuwwrenRQqEnHL4x3uoC
                                value: asObject
                              args:
                                val:
                                  $var:
                                    type:
                                      blueId: GX7CFUmSDrE2MzptunLCCdZwnuwwrenRQqEnHL4x3uoC
                                    value: contractsMap
                        item:
                          type:
                            blueId: GX7CFUmSDrE2MzptunLCCdZwnuwwrenRQqEnHL4x3uoC
                          value: contractKey
                        where:
                          $not:
                            $call:
                              function:
                                type:
                                  blueId: GX7CFUmSDrE2MzptunLCCdZwnuwwrenRQqEnHL4x3uoC
                                value: isMetaKey
                              args:
                                key:
                                  $var:
                                    type:
                                      blueId: GX7CFUmSDrE2MzptunLCCdZwnuwwrenRQqEnHL4x3uoC
                                    value: contractKey
                  keySetObject:
                    args:
                      keys:
                        description: BEX helper argument.
                    expr:
                      $objectFromEntries:
                        $map:
                          in:
                            $call:
                              function:
                                type:
                                  blueId: GX7CFUmSDrE2MzptunLCCdZwnuwwrenRQqEnHL4x3uoC
                                value: asList
                              args:
                                val:
                                  $var:
                                    type:
                                      blueId: GX7CFUmSDrE2MzptunLCCdZwnuwwrenRQqEnHL4x3uoC
                                    value: keys
                          item:
                            type:
                              blueId: GX7CFUmSDrE2MzptunLCCdZwnuwwrenRQqEnHL4x3uoC
                            value: key
                          expr:
                            key:
                              $text:
                                $var:
                                  type:
                                    blueId: GX7CFUmSDrE2MzptunLCCdZwnuwwrenRQqEnHL4x3uoC
                                  value: key
                            val:
                              type:
                                blueId: AwvXD961fmnmqcSQhjMA7r15HpVh39cefb6ZTyUz2Fm2
                              value: true
                  contractPath:
                    args:
                      key:
                        description: BEX helper argument.
                    expr:
                      $pointerJoin:
                        items:
                          - type:
                              blueId: GX7CFUmSDrE2MzptunLCCdZwnuwwrenRQqEnHL4x3uoC
                            value: contracts
                          - $var:
                              type:
                                blueId: GX7CFUmSDrE2MzptunLCCdZwnuwwrenRQqEnHL4x3uoC
                              value: key
                  isContractsPatchEntry:
                    args:
                      entry:
                        description: BEX helper argument.
                    expr:
                      $or:
                        items:
                          - $eq:
                              items:
                                - $text:
                                    $default:
                                      items:
                                        - $var:
                                            name: entry
                                            path:
                                              type:
                                                blueId: GX7CFUmSDrE2MzptunLCCdZwnuwwrenRQqEnHL4x3uoC
                                              value: /path
                                        - type:
                                            blueId: GX7CFUmSDrE2MzptunLCCdZwnuwwrenRQqEnHL4x3uoC
                                          value: ''
                                - type:
                                    blueId: GX7CFUmSDrE2MzptunLCCdZwnuwwrenRQqEnHL4x3uoC
                                  value: /contracts
                          - $startsWith:
                              items:
                                - $text:
                                    $default:
                                      items:
                                        - $var:
                                            name: entry
                                            path:
                                              type:
                                                blueId: GX7CFUmSDrE2MzptunLCCdZwnuwwrenRQqEnHL4x3uoC
                                              value: /path
                                        - type:
                                            blueId: GX7CFUmSDrE2MzptunLCCdZwnuwwrenRQqEnHL4x3uoC
                                          value: ''
                                - type:
                                    blueId: GX7CFUmSDrE2MzptunLCCdZwnuwwrenRQqEnHL4x3uoC
                                  value: /contracts/
                  isProposedChangePatchEntry:
                    args:
                      entry:
                        description: BEX helper argument.
                    expr:
                      $startsWith:
                        items:
                          - $text:
                              $default:
                                items:
                                  - $var:
                                      name: entry
                                      path:
                                        type:
                                          blueId: GX7CFUmSDrE2MzptunLCCdZwnuwwrenRQqEnHL4x3uoC
                                        value: /path
                                  - type:
                                      blueId: GX7CFUmSDrE2MzptunLCCdZwnuwwrenRQqEnHL4x3uoC
                                    value: ''
                          - type:
                              blueId: GX7CFUmSDrE2MzptunLCCdZwnuwwrenRQqEnHL4x3uoC
                            value: /proposedChange
                  hasMatchingRelatedContracts:
                    args:
                      section:
                        description: BEX helper argument.
                      contractKeys:
                        description: BEX helper argument.
                    do:
                      items:
                        - $let:
                            order:
                              items:
                                - type:
                                    blueId: GX7CFUmSDrE2MzptunLCCdZwnuwwrenRQqEnHL4x3uoC
                                  value: related
                                - type:
                                    blueId: GX7CFUmSDrE2MzptunLCCdZwnuwwrenRQqEnHL4x3uoC
                                  value: relatedMap
                            vars:
                              related:
                                $call:
                                  function:
                                    type:
                                      blueId: GX7CFUmSDrE2MzptunLCCdZwnuwwrenRQqEnHL4x3uoC
                                    value: asList
                                  args:
                                    val:
                                      $choose:
                                        cond:
                                          $exists:
                                            $var:
                                              name: section
                                              path:
                                                type:
                                                  blueId: GX7CFUmSDrE2MzptunLCCdZwnuwwrenRQqEnHL4x3uoC
                                                value: /relatedContracts
                                        then:
                                          $var:
                                            name: section
                                            path:
                                              type:
                                                blueId: GX7CFUmSDrE2MzptunLCCdZwnuwwrenRQqEnHL4x3uoC
                                              value: /relatedContracts
                                        else:
                                          items: []
                              relatedMap:
                                $call:
                                  function:
                                    type:
                                      blueId: GX7CFUmSDrE2MzptunLCCdZwnuwwrenRQqEnHL4x3uoC
                                    value: keySetObject
                                  args:
                                    keys:
                                      $var:
                                        type:
                                          blueId: GX7CFUmSDrE2MzptunLCCdZwnuwwrenRQqEnHL4x3uoC
                                        value: related
                        - $returnIf:
                            cond:
                              $eq:
                                items:
                                  - $size:
                                      $var:
                                        type:
                                          blueId: GX7CFUmSDrE2MzptunLCCdZwnuwwrenRQqEnHL4x3uoC
                                        value: related
                                  - type:
                                      blueId: E2LM6qgzWG9ttagq2xTmiZkgYEAgkYedFCmU9v7NnVEq
                                    value: 0
                            expr:
                              type:
                                blueId: AwvXD961fmnmqcSQhjMA7r15HpVh39cefb6ZTyUz2Fm2
                              value: true
                        - $returnIf:
                            cond:
                              $ne:
                                items:
                                  - $size:
                                      $var:
                                        type:
                                          blueId: GX7CFUmSDrE2MzptunLCCdZwnuwwrenRQqEnHL4x3uoC
                                        value: related
                                  - $size:
                                      $var:
                                        type:
                                          blueId: GX7CFUmSDrE2MzptunLCCdZwnuwwrenRQqEnHL4x3uoC
                                        value: contractKeys
                            expr:
                              type:
                                blueId: AwvXD961fmnmqcSQhjMA7r15HpVh39cefb6ZTyUz2Fm2
                              value: false
                        - $returnIf:
                            cond:
                              $ne:
                                items:
                                  - $size:
                                      $keys:
                                        $var:
                                          type:
                                            blueId: GX7CFUmSDrE2MzptunLCCdZwnuwwrenRQqEnHL4x3uoC
                                          value: relatedMap
                                  - $size:
                                      $var:
                                        type:
                                          blueId: GX7CFUmSDrE2MzptunLCCdZwnuwwrenRQqEnHL4x3uoC
                                        value: contractKeys
                            expr:
                              type:
                                blueId: AwvXD961fmnmqcSQhjMA7r15HpVh39cefb6ZTyUz2Fm2
                              value: false
                        - $return:
                            $not:
                              $some:
                                in:
                                  $var:
                                    type:
                                      blueId: GX7CFUmSDrE2MzptunLCCdZwnuwwrenRQqEnHL4x3uoC
                                    value: contractKeys
                                item:
                                  type:
                                    blueId: GX7CFUmSDrE2MzptunLCCdZwnuwwrenRQqEnHL4x3uoC
                                  value: contractKey
                                where:
                                  $not:
                                    $hasKey:
                                      object:
                                        $var:
                                          type:
                                            blueId: GX7CFUmSDrE2MzptunLCCdZwnuwwrenRQqEnHL4x3uoC
                                          value: relatedMap
                                      key:
                                        $var:
                                          type:
                                            blueId: GX7CFUmSDrE2MzptunLCCdZwnuwwrenRQqEnHL4x3uoC
                                          value: contractKey
                  normalizeSection:
                    args:
                      section:
                        description: BEX helper argument.
                      contractKeys:
                        description: BEX helper argument.
                    do:
                      items:
                        - $let:
                            name: related
                            expr:
                              $call:
                                function:
                                  type:
                                    blueId: GX7CFUmSDrE2MzptunLCCdZwnuwwrenRQqEnHL4x3uoC
                                  value: asList
                                args:
                                  val:
                                    $choose:
                                      cond:
                                        $exists:
                                          $var:
                                            name: section
                                            path:
                                              type:
                                                blueId: GX7CFUmSDrE2MzptunLCCdZwnuwwrenRQqEnHL4x3uoC
                                              value: /relatedContracts
                                      then:
                                        $var:
                                          name: section
                                          path:
                                            type:
                                              blueId: GX7CFUmSDrE2MzptunLCCdZwnuwwrenRQqEnHL4x3uoC
                                            value: /relatedContracts
                                      else:
                                        items: []
                        - $return:
                            $merge:
