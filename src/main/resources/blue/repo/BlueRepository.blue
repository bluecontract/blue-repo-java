                                            blueId: GX7CFUmSDrE2MzptunLCCdZwnuwwrenRQqEnHL4x3uoC
                                          value: related
                                    vars:
                                      sectionKey:
                                        $call:
                                          function:
                                            type:
                                              blueId: GX7CFUmSDrE2MzptunLCCdZwnuwwrenRQqEnHL4x3uoC
                                            value: sectionKeyForRemove
                                          args:
                                            entry:
                                              $var:
                                                type:
                                                  blueId: GX7CFUmSDrE2MzptunLCCdZwnuwwrenRQqEnHL4x3uoC
                                                value: entry
                                      related:
                                        $call:
                                          function:
                                            type:
                                              blueId: GX7CFUmSDrE2MzptunLCCdZwnuwwrenRQqEnHL4x3uoC
                                            value: asList
                                          args:
