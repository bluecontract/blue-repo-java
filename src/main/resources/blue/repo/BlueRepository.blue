                                                      - $var:
                                                          type:
                                                            blueId: GX7CFUmSDrE2MzptunLCCdZwnuwwrenRQqEnHL4x3uoC
                                                          value: issues
                                                      - items:
                                                          - $concat:
                                                              items:
                                                                - $var:
                                                                    type:
                                                                      blueId: GX7CFUmSDrE2MzptunLCCdZwnuwwrenRQqEnHL4x3uoC
                                                                    value: itemPath
                                                                - type:
                                                                    blueId: GX7CFUmSDrE2MzptunLCCdZwnuwwrenRQqEnHL4x3uoC
