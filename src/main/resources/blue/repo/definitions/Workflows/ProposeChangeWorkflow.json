{
  "name": "Propose Change Workflow",
  "description": "Stores a proposed change under /proposedChange{postfix}.",
  "type": {
    "blueId": "B5eQ8GaYwECKEtduoWEv8Ri1FvWznuvb3ZXGKqeYUuy"
  },
  "request": {
    "description": "Expected request payload for this workflow.",
    "type": {
      "blueId": "6DTYzUFXoVEV5WjVKmQveSztfXfVN5nr1bso3ygW9ocU"
    }
  },
  "postfix": {
    "description": "Optional postfix used while building proposed change state key.",
    "type": {
      "blueId": "GX7CFUmSDrE2MzptunLCCdZwnuwwrenRQqEnHL4x3uoC"
    }
  },
  "steps": {
    "items": [
      {
        "name": "Prepare",
        "type": {
          "blueId": "4qGDz5yJxXc9dr8bsBE1B2Tg4AWuR4qHPU9H6T29m3KZ"
        },
        "do": {
          "items": [
            {
              "$let": {
                "order": {
                  "items": [
                    {
                      "type": {
                        "blueId": "GX7CFUmSDrE2MzptunLCCdZwnuwwrenRQqEnHL4x3uoC"
                      },
                      "value": "request"
                    },
                    {
                      "type": {
                        "blueId": "GX7CFUmSDrE2MzptunLCCdZwnuwwrenRQqEnHL4x3uoC"
                      },
                      "value": "summary"
                    },
                    {
                      "type": {
                        "blueId": "GX7CFUmSDrE2MzptunLCCdZwnuwwrenRQqEnHL4x3uoC"
                      },
                      "value": "postfix"
                    },
                    {
                      "type": {
                        "blueId": "GX7CFUmSDrE2MzptunLCCdZwnuwwrenRQqEnHL4x3uoC"
                      },
                      "value": "proposedPath"
                    }
                  ]
                },
                "vars": {
                  "request": {
                    "$event": {
                      "type": {
                        "blueId": "GX7CFUmSDrE2MzptunLCCdZwnuwwrenRQqEnHL4x3uoC"
                      },
                      "value": "/message/request"
                    }
                  },
                  "summary": {
                    "$event": {
                      "type": {
                        "blueId": "GX7CFUmSDrE2MzptunLCCdZwnuwwrenRQqEnHL4x3uoC"
                      },
                      "value": "/message/request/summary"
                    }
                  },
                  "postfix": {
                    "$default": {
                      "items": [
                        {
                          "$currentContract": {
                            "type": {
                              "blueId": "GX7CFUmSDrE2MzptunLCCdZwnuwwrenRQqEnHL4x3uoC"
                            },
                            "value": "/postfix"
                          }
                        },
                        {
                          "type": {
                            "blueId": "GX7CFUmSDrE2MzptunLCCdZwnuwwrenRQqEnHL4x3uoC"
                          },
                          "value": ""
                        }
                      ]
                    }
                  },
                  "proposedPath": {
                    "$concat": {
                      "items": [
                        {
                          "type": {
                            "blueId": "GX7CFUmSDrE2MzptunLCCdZwnuwwrenRQqEnHL4x3uoC"
                          },
                          "value": "/proposedChange"
                        },
                        {
                          "$var": {
                            "type": {
                              "blueId": "GX7CFUmSDrE2MzptunLCCdZwnuwwrenRQqEnHL4x3uoC"
                            },
                            "value": "postfix"
                          }
                        }
                      ]
                    }
                  }
                }
              }
            },
            {
              "$returnIf": {
                "cond": {
                  "$or": {
                    "items": [
                      {
                        "$not": {
                          "$truthy": {
                            "$var": {
                              "type": {
                                "blueId": "GX7CFUmSDrE2MzptunLCCdZwnuwwrenRQqEnHL4x3uoC"
                              },
                              "value": "summary"
                            }
                          }
                        }
                      },
                      {
                        "$not": {
                          "$isKind": {
                            "val": {
                              "$var": {
                                "type": {
                                  "blueId": "GX7CFUmSDrE2MzptunLCCdZwnuwwrenRQqEnHL4x3uoC"
                                },
                                "value": "summary"
                              }
                            },
                            "kind": {
                              "type": {
                                "blueId": "GX7CFUmSDrE2MzptunLCCdZwnuwwrenRQqEnHL4x3uoC"
                              },
                              "value": "text"
                            }
                          }
                        }
                      }
                    ]
                  }
                },
                "expr": {
                  "changeset": {
                    "items": []
                  },
                  "events": {
                    "items": [
                      {
                        "type": {
                          "blueId": "6jcAKEeVpGCPenpSnfwwamL2iTHBACRXPFQjEDU5pX1y"
                        },
                        "reason": {
                          "type": {
                            "blueId": "GX7CFUmSDrE2MzptunLCCdZwnuwwrenRQqEnHL4x3uoC"
                          },
                          "value": "summary is missing"
                        }
                      }
                    ]
                  }
                }
              }
            },
            {
              "$returnIf": {
                "cond": {
                  "$exists": {
                    "$document": {
                      "path": {
                        "$var": {
                          "type": {
                            "blueId": "GX7CFUmSDrE2MzptunLCCdZwnuwwrenRQqEnHL4x3uoC"
                          },
                          "value": "proposedPath"
                        }
                      }
                    }
                  }
                },
                "expr": {
                  "changeset": {
                    "items": []
                  },
                  "events": {
                    "items": [
                      {
                        "type": {
                          "blueId": "6jcAKEeVpGCPenpSnfwwamL2iTHBACRXPFQjEDU5pX1y"
                        },
                        "reason": {
                          "$concat": {
                            "items": [
                              {
                                "type": {
                                  "blueId": "GX7CFUmSDrE2MzptunLCCdZwnuwwrenRQqEnHL4x3uoC"
                                },
                                "value": "proposed change already exists at"
                              },
                              {
                                "type": {
                                  "blueId": "GX7CFUmSDrE2MzptunLCCdZwnuwwrenRQqEnHL4x3uoC"
                                },
                                "value": " "
                              },
                              {
                                "$var": {
                                  "type": {
                                    "blueId": "GX7CFUmSDrE2MzptunLCCdZwnuwwrenRQqEnHL4x3uoC"
                                  },
                                  "value": "proposedPath"
                                }
                              }
                            ]
                          }
                        }
                      }
                    ]
                  }
                }
              }
            },
            {
              "$appendChange": {
                "op": {
                  "type": {
                    "blueId": "GX7CFUmSDrE2MzptunLCCdZwnuwwrenRQqEnHL4x3uoC"
                  },
                  "value": "add"
                },
                "path": {
                  "$var": {
                    "type": {
                      "blueId": "GX7CFUmSDrE2MzptunLCCdZwnuwwrenRQqEnHL4x3uoC"
                    },
                    "value": "proposedPath"
                  }
                },
                "val": {
                  "$var": {
                    "type": {
                      "blueId": "GX7CFUmSDrE2MzptunLCCdZwnuwwrenRQqEnHL4x3uoC"
                    },
                    "value": "request"
                  }
                }
              }
            },
            {
              "$return": {
                "changeset": {
                  "$changeset": {
                    "type": {
                      "blueId": "AwvXD961fmnmqcSQhjMA7r15HpVh39cefb6ZTyUz2Fm2"
                    },
                    "value": true
                  }
                },
                "events": {
                  "$events": {
                    "type": {
                      "blueId": "AwvXD961fmnmqcSQhjMA7r15HpVh39cefb6ZTyUz2Fm2"
                    },
                    "value": true
                  }
                }
              }
            }
          ]
        }
      }
    ]
  }
}
